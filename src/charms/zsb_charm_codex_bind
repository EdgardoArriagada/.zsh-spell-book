#!/usr/bin/env zsh
set -euo pipefail

local paneId=${1:?paneId required}
local sessionId=''
local -a wait quiet
shift
zparseopts -D -F -- -wait=wait -quiet=quiet || exit 2
(( $# == 0 )) || { print -u2 -r -- "Unexpected argument: $1"; exit 2; }
if (( $#wait )); then
  sessionId=$(zsb_charm_find_codex_session_id "$paneId") || exit 0
else
  sessionId=$(zsb_charm_get_codex_session_id "$paneId") || exit 0
fi

if zsb_tmux_agent_notification --bind-codex "$sessionId" "$paneId"; then
  if (( ! $#quiet )); then
    tmux display-message 'Codex session bound!'
  fi
fi
