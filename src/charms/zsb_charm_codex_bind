#!/usr/bin/env zsh
set -euo pipefail

local paneId=${1:?paneId required}
local sessionId=''
if [[ ${2-} == --wait ]]; then
  for (( i=0; i<100; i++ )); do
    if [[ $(tmux display-message -pt "$paneId" '#{pane_current_command}') == codex ]]; then
      sessionId=$(zsb_charm_codex_session_id "$paneId") && break
    fi
    sleep 0.2
  done
  [[ -n $sessionId ]] || exit 0
else
  sessionId=$(zsb_charm_codex_session_id "$paneId") || exit 0
fi

if zsb_tmux_agent_notification --bind-codex "$sessionId" "$paneId"
  then tmux display-message 'Codex session bound!'
fi
