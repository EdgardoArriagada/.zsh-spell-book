#!/usr/bin/env zsh
set -euo pipefail

local panePid=${1:?pane PID required}
local workingDir=${2:?working directory required}
local codexPid=$(ps -o tpgid= -p "$panePid" | tr -d ' ')
local sessionId=$(lsof -Fn -p "$codexPid" 2>/dev/null | sed -n 's|^n.*/thread-writer-locks/\(.*\)\.lock$|\1|p' | head -n 1)

if [[ ! $sessionId =~ '^[0-9a-fA-F]{8}(-[0-9a-fA-F]{4}){3}-[0-9a-fA-F]{12}$' ]]; then
  tmux display-message 'No Codex session found in this pane'
  exit 1
fi

tmux new-window -c "$workingDir" "codex fork $sessionId"
